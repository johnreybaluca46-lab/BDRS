{
  "name": "bdrs",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "cross-env ELECTRON=true npm run build && electron-builder",
    "capacitor:build": "cross-env CAPACITOR=true npm run build && npx cap sync android"
  },
  "build": {
    "appId": "com.barangaybuluan.bdrs",
    "productName": "BDRS",
    "directories": {
      "output": "../BDRS-Build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "cookie": "^2.0.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^11.11.1",
    "html2pdf.js": "^0.14.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "firebase-tools": "^15.30.0",
    "jest": "^30.5.1",
    "oxlint": "^1.75.0",
    "terser": "^5.50.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.1.0"
  }
}
